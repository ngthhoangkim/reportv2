DB_REQUEST_TIMEOUT_MS=120000

APP_PORT=3000
PATHS_SOURCE_IMAGE_DIR=\\server\share\img
PATHS_FALLBACK_IMAGE_DIR=\\server\share\documents2
PATHS_LOCAL_IMAGE_DIR=C:\ReportV2\Documents
PATHS_TEMPLATES=C:\ReportV2\Templates
PATHS_OUTPUT=C:\ReportV2\output

S3_UPLOAD_API_BASE=
